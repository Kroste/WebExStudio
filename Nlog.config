<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/nlog-internal.txt">

  <targets>
    <target name="coloredConsole" xsi:type="ColoredConsole"
            layout="${longdate}|${pad:padding=5:inner=${level:uppercase=true}}|${logger:shortName=true}|${masked:inner=${message}}${onexception:inner= |EX\: ${masked:inner=${exception:format=message}}}" >
      <highlight-row condition="level == LogLevel.Trace"  foregroundColor="Magenta" />
      <highlight-row condition="level == LogLevel.Debug"  foregroundColor="DarkGray" />
      <highlight-row condition="level == LogLevel.Info"   foregroundColor="Gray" />
      <highlight-row condition="level == LogLevel.Warn"   foregroundColor="Yellow" />
      <highlight-row condition="level == LogLevel.Error"  foregroundColor="Red" />
      <highlight-row condition="level == LogLevel.Fatal"  foregroundColor="Red" backgroundColor="White" />
    </target>

    <target name="debugFile" xsi:type="File"
            layout="${longdate} ${pad:padding=5:inner=${level:uppercase=true}} ${logger:shortName=true} ${masked:inner=${message}}${onexception:inner=${newline}${masked:inner=${exception:format=tostring}}}"
            fileName="${basedir}/logs/debug.log"
            archiveFileName="${basedir}/logs/archives/debug.{#}.log"
            archiveEvery="Day" maxArchiveFiles="7"
            keepFileOpen="false" encoding="utf-8" />

    <target name="infoFile" xsi:type="File"
            layout="${longdate} ${pad:padding=5:inner=${level:uppercase=true}} ${logger:shortName=true} ${masked:inner=${message}}"
            fileName="${basedir}/logs/info.log"
            archiveFileName="${basedir}/logs/archives/info.{#}.log"
            archiveEvery="Day" maxArchiveFiles="7"
            keepFileOpen="false" encoding="utf-8" />

    <target name="errorFile" xsi:type="File"
            layout="${longdate} ${pad:padding=5:inner=${level:uppercase=true}} ${logger:shortName=true} ${masked:inner=${message}}${newline}${masked:inner=${exception:format=tostring}}"
            fileName="${basedir}/logs/error.log"
            archiveFileName="${basedir}/logs/archives/error.{#}.log"
            archiveEvery="Day" maxArchiveFiles="7"
            keepFileOpen="false" encoding="utf-8" />
  </targets>

  <rules>
    <!-- Debug+ for own code → debug file -->
    <logger name="WebExStudio.*" minlevel="Debug" writeTo="debugFile" />
    <!-- Info+ for everything → colored console + info file -->
    <logger name="*" minlevel="Info" writeTo="coloredConsole,infoFile" />
    <!-- Error+ → dedicated error file -->
    <logger name="*" minlevel="Error" writeTo="errorFile" />
  </rules>
</nlog>
