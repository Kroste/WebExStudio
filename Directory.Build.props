<Project>
  <!--
    Zentrale Versionsnummer für alle Projekte (SemVer: MAJOR.MINOR.PATCH).
    Wird bei jeder inhaltlichen Änderung angepasst (siehe CLAUDE.md).
    Das About-Fenster liest diesen Wert zur Laufzeit aus.
    CI überschreibt die Version bei Releases per -p:Version aus dem Git-Tag.
  -->
  <PropertyGroup>
    <Version>0.60.0</Version>
  </PropertyGroup>

  <!--
    Gemeinsame Projekteinstellungen — gelten für ALLE Projekte im Repo
    (inkl. Tests und samples/). Projektspezifisches (OutputType, AssemblyName,
    EnableDynamicLoading, …) bleibt in der jeweiligen .csproj.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Warnungen sind Fehler: hält den Build dauerhaft warnungsfrei. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
