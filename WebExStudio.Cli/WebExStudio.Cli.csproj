<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Erzeugt das Kommando 'webex' (statt 'WebExStudio.Cli'). -->
    <AssemblyName>webex</AssemblyName>
    <RootNamespace>WebExStudio.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebExStudio.Core\WebExStudio.Core.csproj" />
    <ProjectReference Include="..\WebExStudio.Engine\WebExStudio.Engine.csproj" />
  </ItemGroup>

</Project>
