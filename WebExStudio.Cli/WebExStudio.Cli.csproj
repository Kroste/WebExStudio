<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Erzeugt das Kommando 'webex' (statt 'WebExStudio.Cli'). -->
    <AssemblyName>webex</AssemblyName>
    <RootNamespace>WebExStudio.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebExStudio.Core\WebExStudio.Core.csproj" />
    <ProjectReference Include="..\WebExStudio.Engine\WebExStudio.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Argument-Parsing (internal) im Test-Projekt prüfbar machen. -->
    <InternalsVisibleTo Include="WebExStudio.Cli.Tests" />
  </ItemGroup>

</Project>
