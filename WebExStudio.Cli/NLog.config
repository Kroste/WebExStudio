<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="${tempdir}/WebExStudio/nlog-internal-cli.txt">

  <!--
    Eigene Konfiguration für den Headless-Runner (webex). Unterschied zur GUI-Konfiguration:
    KEIN Konsolen-Target — die CLI schreibt ihre Nutzerausgabe selbst nach stdout/stderr, ein
    zusätzliches NLog-Konsolenziel würde jede Meldung doppelt anzeigen und die Ausgabe für
    Skripte/cron unbrauchbar machen. Es wird deshalb nur in Dateien geloggt.

    Ablageort wie bei der GUI im Benutzer-Datenverzeichnis: die CLI wird typischerweise
    systemweit oder aus einem read-only Paket heraus gestartet, wo neben der Exe nichts
    beschreibbar ist. ACHTUNG: internalLogFile oben ist KEIN Layout.
  -->
  <variable name="logDir" value="${specialfolder:folder=ApplicationData}/WebExStudio/logs" />

  <targets>
    <target name="debugFile" xsi:type="File"
            layout="${longdate} ${pad:padding=5:inner=${level:uppercase=true}} ${logger:shortName=true} ${masked:inner=${message}}${onexception:inner=${newline}${masked:inner=${exception:format=tostring}}}"
            fileName="${logDir}/cli-debug.log"
            archiveEvery="Day" maxArchiveFiles="7"
            keepFileOpen="false" encoding="utf-8" />

    <target name="errorFile" xsi:type="File"
            layout="${longdate} ${pad:padding=5:inner=${level:uppercase=true}} ${logger:shortName=true} ${masked:inner=${message}}${newline}${masked:inner=${exception:format=tostring}}"
            fileName="${logDir}/cli-error.log"
            archiveEvery="Day" maxArchiveFiles="7"
            keepFileOpen="false" encoding="utf-8" />
  </targets>

  <rules>
    <logger name="WebExStudio.*" minlevel="Debug" writeTo="debugFile" />
    <logger name="*" minlevel="Error" writeTo="errorFile" />
  </rules>
</nlog>
