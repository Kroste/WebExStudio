<Project>
  <!--
    Central Package Management (CPM): alle NuGet-Paketversionen werden zentral
    hier gepflegt. Die einzelnen .csproj enthalten nur noch <PackageReference>
    OHNE Version-Attribut. Doku: https://learn.microsoft.com/nuget/consume-packages/central-package-management
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- UI -->
    <PackageVersion Include="Avalonia" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageVersion Include="ReactiveUI" Version="24.1.0" />
    <PackageVersion Include="ReactiveUI.Avalonia" Version="12.1.1" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />

    <!-- Engine -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.62.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />

    <!-- Sicherheit — DPAPI unter Windows (nicht Teil des Shared Frameworks, daher als Paket).
         Auf Linux/macOS greift SecretProtection auf AES mit Maschinen-/Benutzer-Bindung zurück. -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />

    <!-- Logging -->
    <PackageVersion Include="NLog" Version="6.2.0" />
    <PackageVersion Include="NLog.Extensions.Logging" Version="6.2.0" />

    <!-- Tests — xunit.v3 (v2/'xunit' ist deprecated). Der Runner steckt im Paket selbst;
         Microsoft.NET.Test.Sdk/xunit.runner.visualstudio wären der alte VSTest-Pfad.

         BLEIBT auf 3.2.2, obwohl 4.0.0 verfügbar ist: Avalonia.Headless.XUnit
         12.1.1 — die neueste — hängt laut nuspec an xunit.v3 3.2.2 und ist
         gegen v4 binär inkompatibel. Mit 4.0.0 stirbt schon die Testerkennung
         mit MissingMethodException auf
         TestIntrospectionHelper.GetTestCaseDetails, geworfen aus
         AvaloniaFactDiscoverer — also bevor ein einziger Test läuft.
         Erst anheben, wenn Avalonia einen Headless.XUnit-Build gegen v4
         liefert. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <!-- Headless-Avalonia für Fenster-Smoke-Tests (lädt echtes XAML ohne Bildschirm).
         Muss auf derselben Linie wie Avalonia sitzen. -->
    <PackageVersion Include="Avalonia.Headless" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.1" />
  </ItemGroup>
</Project>
