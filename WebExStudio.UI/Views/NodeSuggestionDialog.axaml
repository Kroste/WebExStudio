<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WebExStudio.UI.Views.NodeSuggestionDialog"
        Title="Node-Vorschlag"
        Width="480" Height="380"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        WindowDecorations="None"
        Background="#12121F">

  <Border BorderBrush="#2E2E4E" BorderThickness="1">
    <DockPanel>
      <Border DockPanel.Dock="Top" Background="#1E1E2E"
              BorderBrush="#2E2E4E" BorderThickness="0,0,0,1"
              PointerPressed="OnTitleBarPointerPressed">
        <Grid ColumnDefinitions="*,Auto" Height="36">
          <TextBlock Grid.Column="0" Text="💡 Nächster Node (KI-Vorschlag)"
                     FontSize="12" FontWeight="SemiBold" Foreground="#90A4AE"
                     VerticalAlignment="Center" Margin="14,0" IsHitTestVisible="False"/>
          <Button Grid.Column="1" Click="OnCancel" Content="&#x2715;" FontSize="13"
                  Background="Transparent" Foreground="#90A4AE" BorderThickness="0"
                  Width="40" Height="36" Padding="0"/>
        </Grid>
      </Border>

      <Border DockPanel.Dock="Bottom" Background="#16162A"
              BorderBrush="#2E2E4E" BorderThickness="0,1,0,0" Padding="12,8">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock x:Name="StatusText" Grid.Column="0" Text="" Foreground="#90A4AE"
                     FontSize="12" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Content="Abbrechen" Click="OnCancel" Padding="14,6" Margin="0,0,8,0"/>
          <Button x:Name="AddButton" Grid.Column="2" Content="Hinzufügen" Click="OnAdd"
                  Padding="14,6" IsEnabled="False"
                  Background="#1B5E20" Foreground="White"/>
        </Grid>
      </Border>

      <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="Vorschlag für den nächsten Node nach dem ausgewählten Node:"
                   FontSize="12" Foreground="#B0BEC5" TextWrapping="Wrap"/>

        <Border x:Name="ResultPanel" Background="#0E0E18" BorderBrush="#2E2E4E"
                BorderThickness="1" CornerRadius="6" Padding="12" IsVisible="False">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Typ:" Foreground="#90A4AE" FontSize="12" Width="90"/>
              <TextBlock x:Name="TypeText" Foreground="#ECEFF1" FontSize="13" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Bezeichnung:" Foreground="#90A4AE" FontSize="12" Width="90"/>
              <TextBlock x:Name="LabelText" Foreground="#ECEFF1" FontSize="13"/>
            </StackPanel>
            <StackPanel Spacing="2">
              <TextBlock Text="Konfiguration:" Foreground="#90A4AE" FontSize="12"/>
              <TextBlock x:Name="ConfigText" Foreground="#B0BEC5" FontSize="12"
                         FontFamily="Cascadia Mono,Consolas,monospace" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Spacing="2">
              <TextBlock Text="Begründung:" Foreground="#90A4AE" FontSize="12"/>
              <TextBlock x:Name="ReasonText" Foreground="#B0BEC5" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock x:Name="ErrorText" Foreground="#FF8A80" FontSize="12"
                   TextWrapping="Wrap" IsVisible="False"/>
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
