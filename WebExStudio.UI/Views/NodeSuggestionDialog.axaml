<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:WebExStudio.UI.Controls"
        xmlns:views="using:WebExStudio.UI.Views"
        xmlns:l="using:WebExStudio.UI.Localization"
        x:Class="WebExStudio.UI.Views.NodeSuggestionDialog"
        Title="WebExStudio"
        Width="480" Height="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource KrosteBackgroundBrush}">

  <Border BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="1">
    <DockPanel>
      <controls:TitleBar DockPanel.Dock="Top" Title="{l:Tr Ns_Title}" Icon="💡" />

      <Border DockPanel.Dock="Bottom" Background="{DynamicResource KrosteTitleBarBrush}"
              BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock x:Name="StatusText" Grid.Column="0" Text="" Foreground="{DynamicResource KrosteMutedTextBrush}"
                     FontSize="12" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Content="{l:Tr Common_Cancel}" Click="OnCancel" Padding="14,6" Margin="0,0,8,0"/>
          <Button x:Name="AddButton" Grid.Column="2" Content="{l:Tr Ns_Add}" Click="OnAdd"
                  Padding="14,6" IsEnabled="False"
                  Background="{DynamicResource KrosteSuccessBrush}" Foreground="White"/>
        </Grid>
      </Border>

      <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="{l:Tr Ns_Intro}"
                   FontSize="12" Foreground="{DynamicResource KrosteSecondaryTextBrush}" TextWrapping="Wrap"/>

        <Border x:Name="ResultPanel" Background="{DynamicResource WxSunkenBrush}" BorderBrush="{DynamicResource KrosteBorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="12" IsVisible="False">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{l:Tr Ns_Type}" Foreground="{DynamicResource KrosteMutedTextBrush}" FontSize="12" Width="90"/>
              <TextBlock x:Name="TypeText" Foreground="{DynamicResource KrosteTextBrush}" FontSize="13" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{l:Tr Ns_LabelLabel}" Foreground="{DynamicResource KrosteMutedTextBrush}" FontSize="12" Width="90"/>
              <TextBlock x:Name="LabelText" Foreground="{DynamicResource KrosteTextBrush}" FontSize="13"/>
            </StackPanel>
            <StackPanel Spacing="2">
              <TextBlock Text="{l:Tr Ns_Config}" Foreground="{DynamicResource KrosteMutedTextBrush}" FontSize="12"/>
              <TextBlock x:Name="ConfigText" Foreground="{DynamicResource KrosteSecondaryTextBrush}" FontSize="12"
                         FontFamily="Cascadia Mono,Consolas,monospace" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Spacing="2">
              <TextBlock Text="{l:Tr Ns_Reason}" Foreground="{DynamicResource KrosteMutedTextBrush}" FontSize="12"/>
              <TextBlock x:Name="ReasonText" Foreground="{DynamicResource KrosteSecondaryTextBrush}" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource KrosteDangerBrush}" FontSize="12"
                   TextWrapping="Wrap" IsVisible="False"/>
      </StackPanel>
    </DockPanel>
  </Border>
</views:ChromeWindow>
