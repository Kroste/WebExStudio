<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WebExStudio.UI.ViewModels"
             xmlns:controls="using:WebExStudio.UI.Controls"
             x:Class="WebExStudio.UI.Views.FlowEditorView"
             x:DataType="vm:FlowEditorViewModel">

  <DockPanel>
    <!-- Tab bar -->
    <Border DockPanel.Dock="Top"
            Background="#1A1A2E"
            BorderBrush="#252540"
            BorderThickness="0,0,0,1">
      <ItemsControl x:Name="TabBar" ItemsSource="{Binding OpenTabs}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:FlowTabViewModel">
            <Border Background="#16162A" Margin="0,0,1,0" CornerRadius="4,4,0,0">
              <StackPanel Orientation="Horizontal">
                <Button Content="{Binding Label}"
                        Padding="12,6" FontSize="12"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Tag="{Binding}"
                        Click="OnTabClick"/>
                <Button Content="&#x2715;" FontSize="10"
                        Padding="0" Width="22"
                        Background="Transparent" Foreground="#90A4AE" BorderThickness="0"
                        Cursor="Hand" Tag="{Binding}"
                        IsVisible="{Binding CanClose}"
                        Click="OnTabClose"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <!-- Canvas area -->
    <Grid ClipToBounds="True">
      <!-- Background grid (not transformed) -->
      <controls:GridOverlay x:Name="GridOverlay" IsHitTestVisible="False"/>

      <!-- Node canvas (transformed: zoom + pan) -->
      <controls:NodeCanvas x:Name="Canvas"
                           Background="Transparent"/>

      <!-- Connection renderer (same transform as canvas) -->
      <controls:ConnectionRenderer x:Name="ConnectionRenderer"
                                    IsHitTestVisible="False"/>

      <!-- Hint text -->
      <TextBlock Text="Rechtsklick → Node hinzufügen  |  Scrollen zum Verschieben  |  Strg+Mausrad zum Zoomen  |  Ausgangsport ziehen → Verbindung erstellen"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom"
                 Foreground="#2A2A4E" FontSize="11" Margin="0,0,0,8"
                 IsHitTestVisible="False"/>
    </Grid>
  </DockPanel>
</UserControl>
