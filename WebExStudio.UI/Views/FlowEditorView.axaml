<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WebExStudio.UI.ViewModels"
             xmlns:controls="using:WebExStudio.UI.Controls"
             x:Class="WebExStudio.UI.Views.FlowEditorView"
             x:DataType="vm:FlowEditorViewModel">

  <DockPanel>
    <!-- Tab bar -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource KrosteCardBrush}"
            BorderBrush="{DynamicResource KrosteBorderBrush}"
            BorderThickness="0,0,0,1">
      <ItemsControl x:Name="TabBar" ItemsSource="{Binding OpenTabs}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:FlowTabViewModel">
            <Border Background="{DynamicResource KrosteTitleBarBrush}" Margin="0,0,1,0" CornerRadius="4,4,0,0">
              <StackPanel Orientation="Horizontal">
                <Button Content="{Binding Label}"
                        Padding="12,6" FontSize="12"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Tag="{Binding}"
                        Click="OnTabClick"/>
                <Button Content="&#x2715;" FontSize="10"
                        Padding="0" Width="22"
                        Background="Transparent" Foreground="{DynamicResource KrosteMutedTextBrush}" BorderThickness="0"
                        Cursor="Hand" Tag="{Binding}"
                        IsVisible="{Binding CanClose}"
                        Click="OnTabClose"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <!-- Canvas area: untransformierte Viewport-Fläche → fängt das Mausrad immer ab -->
    <Grid x:Name="CanvasArea" ClipToBounds="True" Background="Transparent"
          PointerWheelChanged="OnCanvasAreaWheel">
      <!-- Background grid (not transformed) -->
      <controls:GridOverlay x:Name="GridOverlay" IsHitTestVisible="False"/>

      <!-- Node canvas (transformed: zoom + pan) -->
      <controls:NodeCanvas x:Name="Canvas"
                           Background="Transparent"/>

      <!-- Connection renderer (same transform as canvas) -->
      <controls:ConnectionRenderer x:Name="ConnectionRenderer"
                                    IsHitTestVisible="False"/>

      <!-- Vorschau beim Ziehen aus der Palette (folgt dem Cursor) -->
      <Border x:Name="DragGhost" IsHitTestVisible="False" IsVisible="False"
              HorizontalAlignment="Left" VerticalAlignment="Top"
              CornerRadius="6" Padding="8,6" BorderThickness="1" Opacity="0.85">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock x:Name="GhostIcon" FontSize="16" VerticalAlignment="Center"/>
          <TextBlock x:Name="GhostName" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>

      <!-- Hint text -->
      <TextBlock Text="Rechtsklick → Node hinzufügen  |  Scrollen zum Verschieben  |  Strg+Mausrad zum Zoomen  |  Ausgangsport ziehen → Verbindung erstellen"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom"
                 Foreground="{DynamicResource KrosteBorderStrongBrush}" FontSize="11" Margin="0,0,0,8"
                 IsHitTestVisible="False"/>
    </Grid>
  </DockPanel>
</UserControl>
