<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:WebExStudio.UI.Localization"
             x:Class="WebExStudio.UI.Views.NodePaletteView">

  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="8,6"
            Background="{DynamicResource KrosteTitleBarBrush}" BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="0,0,0,1">
      <TextBlock Text="{l:Tr Pal_Title}" FontWeight="Bold"
                 Foreground="{DynamicResource KrosteMutedTextBrush}" FontSize="12"/>
    </Border>

    <TextBox DockPanel.Dock="Top"
             x:Name="SearchBox"
             PlaceholderText="{l:Tr Pal_Search}"
             Margin="6" Padding="6,4"
             TextChanged="OnSearchChanged"/>

    <ScrollViewer>
      <StackPanel x:Name="PaletteContent" Margin="4" Spacing="2"/>
    </ScrollViewer>
  </DockPanel>
</UserControl>
