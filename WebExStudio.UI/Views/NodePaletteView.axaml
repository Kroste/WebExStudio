<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WebExStudio.UI.Views.NodePaletteView">

  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="8,6"
            Background="#16162A" BorderBrush="#2E2E4E" BorderThickness="0,0,0,1">
      <TextBlock Text="Node-Palette" FontWeight="Bold"
                 Foreground="#90A4AE" FontSize="12"/>
    </Border>

    <TextBox DockPanel.Dock="Top"
             x:Name="SearchBox"
             Watermark="Suchen…"
             Margin="6" Padding="6,4"
             TextChanged="OnSearchChanged"/>

    <ScrollViewer>
      <StackPanel x:Name="PaletteContent" Margin="4" Spacing="2"/>
    </ScrollViewer>
  </DockPanel>
</UserControl>
