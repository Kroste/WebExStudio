<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WebExStudio.UI.ViewModels"
             x:Class="WebExStudio.UI.Views.PropertiesPanelView">

  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#16162A"
            BorderBrush="#2E2E4E" BorderThickness="0,0,0,1" Padding="8,6">
      <TextBlock Text="Eigenschaften" FontWeight="Bold"
                 Foreground="#90A4AE" FontSize="12"/>
    </Border>

    <!-- Dynamic property form rendered by code-behind -->
    <ScrollViewer>
      <StackPanel x:Name="PropertiesPanel" Spacing="8" Margin="8"/>
    </ScrollViewer>
  </DockPanel>
</UserControl>
