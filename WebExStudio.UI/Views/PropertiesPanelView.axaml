<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WebExStudio.UI.ViewModels"
             xmlns:l="using:WebExStudio.UI.Localization"
             x:Class="WebExStudio.UI.Views.PropertiesPanelView">

  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource KrosteTitleBarBrush}"
            BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
      <TextBlock Text="{l:Tr Prop_Title}" FontWeight="Bold"
                 Foreground="{DynamicResource KrosteMutedTextBrush}" FontSize="12"/>
    </Border>

    <!-- Dynamic property form rendered by code-behind -->
    <ScrollViewer>
      <StackPanel x:Name="PropertiesPanel" Spacing="8" Margin="8"/>
    </ScrollViewer>
  </DockPanel>
</UserControl>
