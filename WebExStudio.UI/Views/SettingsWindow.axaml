<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:WebExStudio.UI.Controls"
        xmlns:views="using:WebExStudio.UI.Views"
        xmlns:l="using:WebExStudio.UI.Localization"
        x:Class="WebExStudio.UI.Views.SettingsWindow"
        Title="Einstellungen"
        Width="560" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource KrosteBackgroundBrush}">

  <Border BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="1">
    <DockPanel>

      <!-- Titelleiste -->
      <controls:TitleBar DockPanel.Dock="Top" Title="{l:Tr Set_Title}" Icon="⚙" />

      <!-- Footer buttons -->
      <Border DockPanel.Dock="Bottom" Background="{DynamicResource KrosteTitleBarBrush}"
              BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <Button Content="{l:Tr Common_Cancel}" Click="OnCancel" Padding="14,6"/>
          <Button Content="{l:Tr Common_Save}" Click="OnSave" Padding="14,6"
                  Background="{DynamicResource KrosteSuccessBrush}" Foreground="White"/>
        </StackPanel>
      </Border>

      <!-- Body: thematisch getrennte Tabs -->
      <TabControl Margin="8">

        <!-- ── Sprache / Language ────────────────────────────────────── -->
        <TabItem Header="{l:Tr Set_Language}">
          <StackPanel Margin="14" Spacing="6">
            <TextBlock Text="{l:Tr Set_Language}" Foreground="{DynamicResource KrosteSecondaryTextBrush}"/>
            <ComboBox x:Name="LanguageBox" HorizontalAlignment="Stretch"
                      SelectionChanged="OnLanguageChanged"/>
            <TextBlock Text="{l:Tr Set_LanguageHint}" FontSize="11" Foreground="{DynamicResource KrosteMutedTextBrush}" TextWrapping="Wrap"/>
          </StackPanel>
        </TabItem>

        <!-- ── Browser ───────────────────────────────────────────────── -->
        <TabItem Header="{l:Tr Set_Tab_Browser}">
          <ScrollViewer>
            <StackPanel Margin="14" Spacing="14">

              <StackPanel Spacing="4">
                <TextBlock Text="{l:Tr Set_BrowserType}" FontSize="12" Foreground="{DynamicResource KrosteSecondaryTextBrush}"/>
                <ComboBox x:Name="BrowserBox" HorizontalAlignment="Stretch">
                  <ComboBoxItem>chromium</ComboBoxItem>
                  <ComboBoxItem>firefox</ComboBoxItem>
                  <ComboBoxItem>webkit</ComboBoxItem>
                </ComboBox>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="{l:Tr Set_Channel}"
                           FontSize="12" Foreground="{DynamicResource KrosteSecondaryTextBrush}" TextWrapping="Wrap"/>
                <ComboBox x:Name="ChannelBox" HorizontalAlignment="Stretch">
                  <ComboBoxItem Content=""/>
                  <ComboBoxItem Content="chrome"/>
                  <ComboBoxItem Content="msedge"/>
                  <ComboBoxItem Content="brave"/>
                  <ComboBoxItem Content="chrome-beta"/>
                  <ComboBoxItem Content="msedge-beta"/>
                </ComboBox>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="{l:Tr Set_ExePath}"
                           FontSize="12" Foreground="{DynamicResource KrosteSecondaryTextBrush}"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <TextBox Grid.Column="0" x:Name="ExePathBox" PlaceholderText="{l:Tr Set_ExePathPlaceholder}"/>
                  <Button Grid.Column="1" Content="…" Click="OnBrowseExe" Padding="12,0"/>
                </Grid>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="{l:Tr Set_DriverPath}"
                           FontSize="12" Foreground="{DynamicResource KrosteSecondaryTextBrush}"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <TextBox Grid.Column="0" x:Name="DriverPathBox" PlaceholderText="{l:Tr Set_DriverPlaceholder}"/>
                  <Button Grid.Column="1" Content="…" Click="OnBrowseDriver" Padding="12,0"/>
                </Grid>
                <StackPanel Spacing="2" Margin="0,2,0,0">
                  <TextBlock FontSize="11" Foreground="{DynamicResource KrosteMutedTextBrush}" TextWrapping="Wrap"
                             Text="{l:Tr Set_DriverHelp1}"/>
                  <Button Content="playwright.dev/dotnet/docs/browsers ↗" Click="OnOpenDriverHelp"
                          Background="Transparent" BorderThickness="0" Padding="0"
                          Foreground="{DynamicResource KrosteGoldBrush}" Cursor="Hand" FontSize="11" HorizontalAlignment="Left"/>
                  <TextBlock FontSize="11" Foreground="{DynamicResource KrosteMutedTextBrush}" TextWrapping="Wrap"
                             Text="{l:Tr Set_DriverHelp2}"/>
                </StackPanel>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="{l:Tr Set_DownloadPath}"
                           FontSize="12" Foreground="{DynamicResource KrosteSecondaryTextBrush}"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <TextBox Grid.Column="0" x:Name="DownloadDirBox" PlaceholderText="{l:Tr Set_DownloadPlaceholder}"/>
                  <Button Grid.Column="1" Content="…" Click="OnBrowseDownload" Padding="12,0"/>
                </Grid>
              </StackPanel>

              <CheckBox x:Name="HeadlessBox" Content="{l:Tr Set_Headless}"
                        Foreground="{DynamicResource KrosteSecondaryTextBrush}"/>
              <CheckBox x:Name="MaximizedBox" Content="{l:Tr Set_Maximized}"
                        Foreground="{DynamicResource KrosteSecondaryTextBrush}"/>

              <StackPanel Spacing="4">
                <CheckBox x:Name="SessionPersistBox"
                          Content="{l:Tr Set_SessionReuse}"
                          Foreground="{DynamicResource KrosteSecondaryTextBrush}"/>
                <TextBlock Text="{l:Tr Set_SessionFile}"
                           FontSize="12" Foreground="{DynamicResource KrosteSecondaryTextBrush}"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <TextBox Grid.Column="0" x:Name="SessionFileBox" PlaceholderText="{l:Tr Set_SessionPlaceholder}"/>
                  <Button Grid.Column="1" Content="…" Click="OnBrowseSession" Padding="12,0"/>
                </Grid>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ── Netzwerk / Proxy ──────────────────────────────────────── -->
        <TabItem Header="{l:Tr Set_Tab_Network}">
          <ScrollViewer>
            <StackPanel Margin="14" Spacing="14">

              <TextBlock Text="{l:Tr Set_ProxyIntro}"
                         FontSize="12" Foreground="{DynamicResource KrosteSecondaryTextBrush}" TextWrapping="Wrap"/>

              <StackPanel Spacing="4">
                <TextBlock Text="{l:Tr Set_ProxyServer}"
                           FontSize="12" Foreground="{DynamicResource KrosteSecondaryTextBrush}"/>
                <TextBox x:Name="ProxyServerBox" PlaceholderText="{l:Tr Set_ProxyServerPlaceholder}"/>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="{l:Tr Set_ProxyBypass}" FontSize="12" Foreground="{DynamicResource KrosteSecondaryTextBrush}"/>
                <TextBox x:Name="ProxyBypassBox" PlaceholderText="{l:Tr Set_ProxyBypassPlaceholder}"/>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="{l:Tr Set_ProxyUser}" FontSize="12" Foreground="{DynamicResource KrosteSecondaryTextBrush}"/>
                <TextBox x:Name="ProxyUserBox"/>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="{l:Tr Set_ProxyPass}" FontSize="12" Foreground="{DynamicResource KrosteSecondaryTextBrush}"/>
                <TextBox x:Name="ProxyPassBox" PasswordChar="•"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ── KI ────────────────────────────────────────────────────── -->
        <TabItem Header="{l:Tr Set_Tab_Ai}">
          <ScrollViewer>
            <StackPanel Margin="14" Spacing="14">

              <TextBlock Text="{l:Tr Set_AiIntro}"
                         FontSize="12" Foreground="{DynamicResource KrosteSecondaryTextBrush}" TextWrapping="Wrap"/>

              <StackPanel Spacing="4">
                <TextBlock Text="{l:Tr Set_Provider}" FontSize="12" Foreground="{DynamicResource KrosteSecondaryTextBrush}"/>
                <ComboBox x:Name="AiProviderBox" HorizontalAlignment="Stretch">
                  <ComboBoxItem Content="anthropic"/>
                  <ComboBoxItem Content="openai"/>
                  <ComboBoxItem Content="gemini"/>
                  <ComboBoxItem Content="perplexity"/>
                  <ComboBoxItem Content="ollama"/>
                </ComboBox>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <Button Grid.Column="0" x:Name="DetectLocalAiButton" Content="{l:Tr Set_DetectLocalAi}"
                          Click="OnDetectLocalAi" Padding="10,4"
                          ToolTip.Tip="{l:Tr Set_DetectLocalAiTip}"/>
                  <TextBlock Grid.Column="1" x:Name="LocalAiStatus" VerticalAlignment="Center"
                             FontSize="11" Foreground="{DynamicResource KrosteMutedTextBrush}" TextWrapping="Wrap"/>
                </Grid>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="{l:Tr Set_ApiKey}" FontSize="12" Foreground="{DynamicResource KrosteSecondaryTextBrush}"/>
                <TextBox x:Name="AiApiKeyBox" PasswordChar="•" PlaceholderText="{l:Tr Set_ApiKeyPlaceholder}"/>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="{l:Tr Set_Model}" FontSize="12" Foreground="{DynamicResource KrosteSecondaryTextBrush}"/>
                <TextBox x:Name="AiModelBox" PlaceholderText="{l:Tr Set_ModelPlaceholder}"/>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="{l:Tr Set_BaseUrl}" FontSize="12" Foreground="{DynamicResource KrosteSecondaryTextBrush}"/>
                <TextBox x:Name="AiBaseUrlBox" PlaceholderText="{l:Tr Set_BaseUrlPlaceholder}"/>
              </StackPanel>

              <Border Background="{DynamicResource KrosteBorderBrush}" Height="1" Margin="0,4"/>

              <CheckBox x:Name="AiSendHintsBox" Content="{l:Tr Set_SendHints}"
                        Foreground="{DynamicResource KrosteSecondaryTextBrush}"/>
              <StackPanel Spacing="4">
                <TextBlock Text="{l:Tr Set_Hints}"
                           FontSize="12" Foreground="{DynamicResource KrosteSecondaryTextBrush}" TextWrapping="Wrap"/>
                <TextBox x:Name="AiHintsBox" AcceptsReturn="True" TextWrapping="Wrap"
                         Height="140" VerticalContentAlignment="Top"
                         PlaceholderText="{l:Tr Set_HintsPlaceholder}"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="{l:Tr Set_Tab_Plugins}">
          <DockPanel Margin="0">
            <Border DockPanel.Dock="Top" Background="{DynamicResource KrosteTitleBarBrush}" Padding="14,8">
              <TextBlock Text="{l:Tr Set_PluginsIntro}"
                         FontSize="11" Foreground="{DynamicResource KrosteMutedTextBrush}" TextWrapping="Wrap"/>
            </Border>
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource KrosteTitleBarBrush}" BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" x:Name="PluginDirsText" FontSize="10" Foreground="{DynamicResource WxFaintTextBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Content="{l:Tr Set_OpenFolder}" Click="OnOpenPluginFolder" Padding="10,5"/>
              </Grid>
            </Border>
            <ScrollViewer Padding="12">
              <StackPanel x:Name="PluginsHost" Spacing="4"/>
            </ScrollViewer>
          </DockPanel>
        </TabItem>

      </TabControl>
    </DockPanel>
  </Border>
</views:ChromeWindow>
