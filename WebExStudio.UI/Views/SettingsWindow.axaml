<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WebExStudio.UI.Views.SettingsWindow"
        Title="Einstellungen"
        Width="560" Height="640"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SystemDecorations="None"
        Background="#12121F">

  <Border BorderBrush="#2E2E4E" BorderThickness="1">
    <DockPanel>

      <!-- Titelleiste -->
      <Border DockPanel.Dock="Top" Background="#1E1E2E"
              BorderBrush="#2E2E4E" BorderThickness="0,0,0,1"
              PointerPressed="OnTitleBarPointerPressed">
        <Grid ColumnDefinitions="*,Auto" Height="36">
          <TextBlock Grid.Column="0" Text="⚙ Einstellungen" FontSize="12" FontWeight="SemiBold"
                     Foreground="#90A4AE" VerticalAlignment="Center" Margin="14,0"
                     IsHitTestVisible="False"/>
          <Button Grid.Column="1" Click="OnCancel" Content="&#x2715;" FontSize="13"
                  Background="Transparent" Foreground="#90A4AE" BorderThickness="0"
                  Width="40" Height="36" Padding="0"/>
        </Grid>
      </Border>

      <!-- Footer buttons -->
      <Border DockPanel.Dock="Bottom" Background="#16162A"
              BorderBrush="#2E2E4E" BorderThickness="0,1,0,0" Padding="12,8">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <Button Content="Abbrechen" Click="OnCancel" Padding="14,6"/>
          <Button Content="Speichern" Click="OnSave" Padding="14,6"
                  Background="#1B5E20" Foreground="White"/>
        </StackPanel>
      </Border>

      <!-- Body -->
      <ScrollViewer>
      <StackPanel Margin="20" Spacing="14">

        <TextBlock Text="Browser" FontWeight="Bold" Foreground="#90A4AE" FontSize="13"/>

        <StackPanel Spacing="4">
          <TextBlock Text="Browser-Typ" FontSize="12" Foreground="#B0BEC5"/>
          <ComboBox x:Name="BrowserBox" HorizontalAlignment="Stretch">
            <ComboBoxItem>chromium</ComboBoxItem>
            <ComboBoxItem>firefox</ComboBoxItem>
            <ComboBoxItem>webkit</ComboBoxItem>
          </ComboBox>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="System-Browser (Channel) — leer = Standard/Bundled"
                     FontSize="12" Foreground="#B0BEC5"/>
          <ComboBox x:Name="ChannelBox" HorizontalAlignment="Stretch">
            <ComboBoxItem Content=""/>
            <ComboBoxItem Content="chrome"/>
            <ComboBoxItem Content="msedge"/>
            <ComboBoxItem Content="chrome-beta"/>
            <ComboBoxItem Content="msedge-beta"/>
          </ComboBox>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="Browser-Programmpfad (leer = System/Standard)"
                     FontSize="12" Foreground="#B0BEC5"/>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <TextBox Grid.Column="0" x:Name="ExePathBox" Watermark="z. B. /usr/bin/google-chrome"/>
            <Button Grid.Column="1" Content="…" Click="OnBrowseExe" Padding="12,0"/>
          </Grid>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="Playwright-Treiberpfad (nur falls nicht automatisch gefunden)"
                     FontSize="12" Foreground="#B0BEC5"/>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <TextBox Grid.Column="0" x:Name="DriverPathBox" Watermark="Ordner der .playwright/node-Installation"/>
            <Button Grid.Column="1" Content="…" Click="OnBrowseDriver" Padding="12,0"/>
          </Grid>
        </StackPanel>

        <CheckBox x:Name="HeadlessBox" Content="Headless (ohne sichtbares Browserfenster)"
                  Foreground="#B0BEC5"/>

        <Border Background="#2E2E4E" Height="1" Margin="0,4"/>

        <TextBlock Text="KI-Anbindung (Flow aus Beschreibung)" FontWeight="Bold"
                   Foreground="#90A4AE" FontSize="13"/>

        <StackPanel Spacing="4">
          <TextBlock Text="Anbieter" FontSize="12" Foreground="#B0BEC5"/>
          <ComboBox x:Name="AiProviderBox" HorizontalAlignment="Stretch">
            <ComboBoxItem Content="anthropic"/>
            <ComboBoxItem Content="openai"/>
            <ComboBoxItem Content="ollama"/>
          </ComboBox>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="API-Schlüssel (bei Ollama nicht nötig)" FontSize="12" Foreground="#B0BEC5"/>
          <TextBox x:Name="AiApiKeyBox" PasswordChar="•" Watermark="sk-…"/>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="Modell (leer = Standard des Anbieters)" FontSize="12" Foreground="#B0BEC5"/>
          <TextBox x:Name="AiModelBox" Watermark="z. B. claude-sonnet-4-6 / gpt-4o / llama3.1"/>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="Basis-URL (optional, z. B. lokale Ollama-Instanz)" FontSize="12" Foreground="#B0BEC5"/>
          <TextBox x:Name="AiBaseUrlBox" Watermark="leer = Standard"/>
        </StackPanel>

      </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
