<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:WebExStudio.UI.Controls"
        xmlns:views="using:WebExStudio.UI.Views"
        xmlns:l="using:WebExStudio.UI.Localization"
        x:Class="WebExStudio.UI.Views.SubnodeDialog"
        Title="WebExStudio"
        Width="440" Height="210"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource KrosteBackgroundBrush}">

  <Border BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="1">
    <DockPanel>
      <controls:TitleBar x:Name="WindowTitleBar" DockPanel.Dock="Top" Icon="📑" />

      <Border DockPanel.Dock="Bottom" Background="{DynamicResource KrosteTitleBarBrush}"
              BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <Button Content="{l:Tr Common_Cancel}" Click="OnCancel" Padding="14,6"/>
          <Button Content="{l:Tr Common_Ok}" Click="OnOk" Padding="14,6"
                  Background="{DynamicResource KrosteSuccessBrush}" Foreground="White"/>
        </StackPanel>
      </Border>

      <StackPanel Margin="20" Spacing="12">
        <StackPanel Spacing="4">
          <TextBlock Text="{l:Tr Sub_NameLabel}"
                     FontSize="12" Foreground="{DynamicResource KrosteSecondaryTextBrush}"/>
          <TextBox x:Name="NameBox"/>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="{l:Tr Sub_LabelLabel}" FontSize="12" Foreground="{DynamicResource KrosteSecondaryTextBrush}"/>
          <TextBox x:Name="LabelBox"/>
        </StackPanel>
      </StackPanel>
    </DockPanel>
  </Border>
</views:ChromeWindow>
