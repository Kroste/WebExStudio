<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WebExStudio.UI.ViewModels"
             xmlns:l="using:WebExStudio.UI.Localization"
             x:Class="WebExStudio.UI.Views.TracePanelView"
             x:DataType="vm:TracePanelViewModel">

  <DockPanel>
    <!-- Header toolbar -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource KrosteTitleBarBrush}"
            BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="0,0,0,1" Padding="6,4">
      <DockPanel>
        <TextBlock Text="{l:Tr Trace_Title}" FontWeight="Bold"
                   Foreground="{DynamicResource KrosteMutedTextBrush}" FontSize="12" VerticalAlignment="Center"/>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
          <CheckBox Content="{l:Tr Trace_AutoScroll}"
                    IsChecked="{Binding AutoScroll}"
                    Foreground="{DynamicResource KrosteMutedTextBrush}" FontSize="11"/>
          <Button Content="{l:Tr Trace_Clear}" Click="OnClear"
                  Padding="6,2" FontSize="11"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Log list -->
    <ScrollViewer x:Name="Scroll" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Entries}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TraceEntryViewModel">
            <Border Padding="6,3" BorderBrush="{DynamicResource KrosteBorderStrongBrush}" BorderThickness="0,0,0,1"
                    Background="Transparent" Cursor="Hand"
                    DoubleTapped="OnEntryDoubleTapped"
                    ToolTip.Tip="{l:Tr Trace_Tip}">
              <Border.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="↪ Zum Node springen" Click="OnGoToNode"/>
                  <MenuItem Header="📋 Zeile kopieren" Click="OnCopyEntry"/>
                  <MenuItem Header="💬 An KI-Chat senden" Click="OnSendToChat"/>
                </ContextMenu>
              </Border.ContextMenu>
              <Grid ColumnDefinitions="70,80,100,*,Auto">

                <TextBlock Grid.Column="0" Text="{Binding Time}"
                           FontFamily="Monospace" FontSize="11"
                           Foreground="{DynamicResource WxFaintTextBrush}" VerticalAlignment="Center"/>

                <Border Grid.Column="1"
                        Background="{Binding StatusColor}"
                        CornerRadius="3" Padding="4,1" Margin="2,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                  <TextBlock Text="{Binding StatusText}"
                             FontSize="10" Foreground="White"
                             FontWeight="Bold"/>
                </Border>

                <TextBlock Grid.Column="2" Text="{Binding ActionType}"
                           FontSize="11" Foreground="{DynamicResource KrosteSuccessBrush}"
                           VerticalAlignment="Center" FontFamily="Monospace"/>

                <SelectableTextBlock Grid.Column="3" Text="{Binding Message}"
                           FontSize="11" Foreground="{DynamicResource KrosteSecondaryTextBrush}"
                           VerticalAlignment="Center"
                           IsVisible="{Binding HasMessage}"/>

                <TextBlock Grid.Column="4" Text="{Binding TargetName}"
                           FontSize="10" Foreground="{DynamicResource KrosteBorderStrongBrush}"
                           VerticalAlignment="Center" Margin="8,0,4,0"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
