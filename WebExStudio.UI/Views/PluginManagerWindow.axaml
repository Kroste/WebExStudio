<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WebExStudio.UI.Views.PluginManagerWindow"
        Title="Plugins"
        Width="560" Height="440"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        WindowDecorations="None"
        Background="#12121F">

  <Border BorderBrush="#2E2E4E" BorderThickness="1">
    <DockPanel>
      <Border DockPanel.Dock="Top" Background="#1E1E2E" BorderBrush="#2E2E4E" BorderThickness="0,0,0,1"
              PointerPressed="OnTitleBarPointerPressed">
        <Grid ColumnDefinitions="*,Auto" Height="36">
          <TextBlock Grid.Column="0" Text="🧩  Plugins" FontSize="12" FontWeight="SemiBold"
                     Foreground="#90A4AE" VerticalAlignment="Center" Margin="14,0" IsHitTestVisible="False"/>
          <Button Grid.Column="1" Click="OnClose" Content="&#x2715;" FontSize="13"
                  Background="Transparent" Foreground="#90A4AE" BorderThickness="0" Width="40" Height="36" Padding="0"/>
        </Grid>
      </Border>

      <Border DockPanel.Dock="Top" Background="#16162A" Padding="14,8">
        <TextBlock Text="Eigene Nodes als DLL im plugins-Ordner. Änderungen (aktiv/inaktiv) wirken nach einem Neustart."
                   FontSize="11" Foreground="#90A4AE" TextWrapping="Wrap"/>
      </Border>

      <!-- Fußzeile -->
      <Border DockPanel.Dock="Bottom" Background="#16162A" BorderBrush="#2E2E4E" BorderThickness="0,1,0,0" Padding="12,8">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <TextBlock Grid.Column="0" x:Name="DirsText" FontSize="10" Foreground="#607D8B"
                     VerticalAlignment="Center" TextWrapping="Wrap"/>
          <Button Grid.Column="1" Content="📂 Ordner öffnen" Click="OnOpenFolder" Padding="10,5"/>
          <Button Grid.Column="2" Content="Schließen" Click="OnClose" Padding="14,5"/>
        </Grid>
      </Border>

      <ScrollViewer Padding="12">
        <StackPanel x:Name="PluginsHost" Spacing="4"/>
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
