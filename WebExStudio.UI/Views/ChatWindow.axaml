<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:WebExStudio.UI.Controls"
        xmlns:views="using:WebExStudio.UI.Views"
        xmlns:vm="using:WebExStudio.UI.ViewModels"
        xmlns:l="using:WebExStudio.UI.Localization"
        xmlns:text="using:WebExStudio.UI.Text"
        x:Class="WebExStudio.UI.Views.ChatWindow"
        x:DataType="vm:ChatViewModel"
        Title="WebExStudio"
        Width="520" Height="640"
        MinWidth="380" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource KrosteBackgroundBrush}">

  <Border BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="1">
    <DockPanel>

      <!-- Titelleiste -->
      <controls:TitleBar DockPanel.Dock="Top" Title="{l:Tr Chat_Title}" Icon="💬" />

      <!-- Eingabe -->
      <Border DockPanel.Dock="Bottom" Background="{DynamicResource KrosteTitleBarBrush}"
              BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="0,1,0,0" Padding="12,10">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox Grid.Column="0" x:Name="InputBox"
                   Text="{Binding Input}"
                   AcceptsReturn="True" TextWrapping="Wrap"
                   MinHeight="44" MaxHeight="120"
                   VerticalContentAlignment="Center"
                   PlaceholderText="{l:Tr Chat_InputPlaceholder}"
                   KeyDown="OnInputKeyDown"/>
          <Button Grid.Column="1" Content="{l:Tr Chat_Send}" Click="OnSend"
                  IsEnabled="{Binding CanSend}" Padding="16,8"
                  VerticalAlignment="Bottom"
                  Background="{DynamicResource KrosteSuccessBrush}" Foreground="White"/>
        </Grid>
      </Border>

      <!-- Fester Lade-Balken: immer erreichbar, sobald die letzte Antwort einen Flow enthält -->
      <Border DockPanel.Dock="Bottom" Background="{DynamicResource KrosteAccentSoftBrush}"
              BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="0,1,0,0" Padding="10,6"
              IsVisible="{Binding HasLoadableFlow}">
        <Button Click="OnLoadLatestFlow"
                Content="{Binding LoadableFlowNote}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Background="{DynamicResource KrosteAccentBrush}" Foreground="White" FontWeight="SemiBold"
                BorderBrush="{DynamicResource KrosteAccentHoverBrush}" BorderThickness="1" CornerRadius="6" Padding="12,9"
                ToolTip.Tip="{l:Tr Chat_LoadLatestTip}"/>
      </Border>

      <!-- Verlauf -->
      <ScrollViewer x:Name="Scroller" Padding="12">
        <ItemsControl ItemsSource="{Binding Messages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChatTurnViewModel">
              <Border Background="{Binding Bubble}" BorderBrush="{Binding Border}"
                      BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,4"
                      MaxWidth="420" HorizontalAlignment="{Binding Align}">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding RoleLabel}" FontSize="10" FontWeight="Bold"
                             Foreground="{DynamicResource KrosteMutedTextBrush}"/>
                  <!-- Sanitize gegen den Layout-Hänger bei Leerzeilen (WrapSafeText) -->
                  <SelectableTextBlock Text="{Binding Content, Converter={x:Static text:WrapSafeTextConverter.Instance}}" TextWrapping="Wrap"
                                       Foreground="{Binding TextBrush}" FontSize="13"/>
                  <Button Content="{Binding FlowNote}" Click="OnLoadFlow"
                          IsVisible="{Binding HasFlow}"
                          Background="{DynamicResource KrosteAccentBrush}" Foreground="White" FontWeight="SemiBold"
                          BorderBrush="{DynamicResource KrosteAccentHoverBrush}" BorderThickness="1" CornerRadius="6"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          Padding="12,9" FontSize="13" Margin="0,4,0,0"
                          ToolTip.Tip="{l:Tr Chat_LoadFlowTip}"/>
                  <Button Content="{l:Tr Chat_Remember}" Click="OnRememberHint"
                          IsVisible="{Binding CanRemember}"
                          Background="Transparent" Foreground="{DynamicResource KrosteMutedTextBrush}"
                          BorderBrush="{DynamicResource KrosteBorderStrongBrush}" BorderThickness="1" CornerRadius="6"
                          HorizontalAlignment="Left" Padding="8,3" FontSize="11" Margin="0,4,0,0"
                          ToolTip.Tip="{l:Tr Chat_RememberTip}"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

    </DockPanel>
  </Border>

</views:ChromeWindow>
