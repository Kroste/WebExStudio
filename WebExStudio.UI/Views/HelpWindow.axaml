<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:WebExStudio.UI.Controls"
        xmlns:views="using:WebExStudio.UI.Views"
        xmlns:l="using:WebExStudio.UI.Localization"
        x:Class="WebExStudio.UI.Views.HelpWindow"
        Title="WebExStudio"
        Width="640" Height="720"
        MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource KrosteBackgroundBrush}">

  <Border BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="1">
      <Grid RowDefinitions="Auto,*">

        <!-- Titelleiste -->
        <controls:TitleBar Grid.Row="0" Title="{l:Tr Help_Title}" Icon="❓" />

        <!-- Inhalt: zur Laufzeit aus der eingebetteten README gerendert -->
        <ScrollViewer Grid.Row="1" Padding="22,14,22,18">
          <ContentControl x:Name="HelpContent"/>
        </ScrollViewer>
      </Grid>
    </Border>

</views:ChromeWindow>
