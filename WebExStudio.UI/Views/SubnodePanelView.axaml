<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WebExStudio.UI.ViewModels"
             xmlns:l="using:WebExStudio.UI.Localization"
             x:Class="WebExStudio.UI.Views.SubnodePanelView"
             x:DataType="vm:MainWindowViewModel">

  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="8,6"
            Background="#16162A" BorderBrush="#2E2E4E" BorderThickness="0,1,0,1">
      <DockPanel>
        <TextBlock Text="{l:Tr SubP_Title}" FontWeight="Bold" Foreground="#90A4AE" FontSize="12"
                   VerticalAlignment="Center"/>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
          <Button Content="＋" Click="OnNew" ToolTip.Tip="{l:Tr SubP_NewTip}"
                  Padding="6,2" FontSize="12" Background="Transparent" Foreground="#90A4AE" BorderThickness="0"/>
          <Button Content="✎" Click="OnRename" ToolTip.Tip="{l:Tr SubP_RenameTip}"
                  Padding="6,2" FontSize="12" Background="Transparent" Foreground="#90A4AE" BorderThickness="0"/>
          <Button Content="🗑" Click="OnDelete" ToolTip.Tip="{l:Tr SubP_DeleteTip}"
                  Padding="6,2" FontSize="12" Background="Transparent" Foreground="#90A4AE" BorderThickness="0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <ScrollViewer>
      <ListBox x:Name="SubnodeList"
               ItemsSource="{Binding FlowEditor.Subnodes}"
               Background="Transparent"
               Padding="4"
               DoubleTapped="OnItemDoubleTapped">
        <!-- Standard-Auswahlhintergrund von Fluent abschalten, damit der eigene Rahmen wirkt. -->
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
          </Style>
          <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
          </Style>
          <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
          </Style>
          <!-- Eigene Hover-/Auswahl-Optik auf dem Rahmen wie bei den Palette-Nodes. -->
          <Style Selector="ListBoxItem:pointerover Border#SubBorder">
            <Setter Property="Background" Value="#50F57F17"/>
          </Style>
          <Style Selector="ListBoxItem:selected Border#SubBorder">
            <Setter Property="Background" Value="#50F57F17"/>
            <Setter Property="BorderBrush" Value="#F57F17"/>
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:FlowTabViewModel">
            <Border x:Name="SubBorder"
                    Margin="2,1" Padding="8,6" CornerRadius="6"
                    Background="#28F57F17" BorderBrush="#50F57F17" BorderThickness="1"
                    Cursor="Hand">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="🧩" FontSize="16" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Label}" Foreground="White" FontSize="12"/>
                  <TextBlock Text="{Binding Name}" Foreground="#607D8B" FontSize="10"
                             TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </ScrollViewer>
  </DockPanel>
</UserControl>
