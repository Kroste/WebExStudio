<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:WebExStudio.UI.Localization"
        x:Class="WebExStudio.UI.Views.PasswordDialog"
        Title="WebExStudio"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        WindowDecorations="None"
        Background="#12121F">

  <Border BorderBrush="#2E2E4E" BorderThickness="1">
    <Grid RowDefinitions="Auto,*">
      <Border Grid.Row="0" Background="#1E1E2E" BorderBrush="#2E2E4E" BorderThickness="0,0,0,1"
              PointerPressed="OnTitleBarPointerPressed">
        <Grid ColumnDefinitions="*,Auto" Height="36">
          <TextBlock x:Name="TitleText" Grid.Column="0" FontSize="12" FontWeight="SemiBold"
                     Foreground="#90A4AE" VerticalAlignment="Center" Margin="14,0" IsHitTestVisible="False"/>
          <Button Grid.Column="1" Click="OnCancel" Content="&#x2715;" FontSize="13"
                  Background="Transparent" Foreground="#90A4AE" BorderThickness="0" Width="40" Height="36" Padding="0"/>
        </Grid>
      </Border>

      <StackPanel Grid.Row="1" Margin="18" Spacing="8">
        <TextBlock x:Name="PromptText" FontSize="12" Foreground="#B0BEC5" TextWrapping="Wrap"/>
        <TextBox x:Name="PwBox" PasswordChar="•" PlaceholderText="{l:Tr Pw_MasterPlaceholder}" KeyDown="OnKeyDownBox"/>
        <TextBox x:Name="PwBox2" PasswordChar="•" PlaceholderText="{l:Tr Pw_ConfirmPlaceholder}" IsVisible="False" KeyDown="OnKeyDownBox"/>
        <TextBlock x:Name="ErrorText" FontSize="11" Foreground="#FF8A80" TextWrapping="Wrap" IsVisible="False"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
          <Button Content="{l:Tr Common_Cancel}" Click="OnCancel" Padding="14,6"/>
          <Button Content="{l:Tr Common_Ok}" Click="OnOk" Padding="18,6" Background="#1B5E20" Foreground="White"/>
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</Window>
