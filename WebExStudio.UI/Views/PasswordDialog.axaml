<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:WebExStudio.UI.Controls"
        xmlns:views="using:WebExStudio.UI.Views"
        xmlns:l="using:WebExStudio.UI.Localization"
        x:Class="WebExStudio.UI.Views.PasswordDialog"
        Title="WebExStudio"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource KrosteBackgroundBrush}">

  <Border BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="1">
    <Grid RowDefinitions="Auto,*">
      <controls:TitleBar x:Name="WindowTitleBar" Grid.Row="0" Icon="🔒" />

      <StackPanel Grid.Row="1" Margin="18" Spacing="8">
        <TextBlock x:Name="PromptText" FontSize="12" Foreground="{DynamicResource KrosteSecondaryTextBrush}" TextWrapping="Wrap"/>
        <TextBox x:Name="PwBox" PasswordChar="•" PlaceholderText="{l:Tr Pw_MasterPlaceholder}" KeyDown="OnKeyDownBox"/>
        <TextBox x:Name="PwBox2" PasswordChar="•" PlaceholderText="{l:Tr Pw_ConfirmPlaceholder}" IsVisible="False" KeyDown="OnKeyDownBox"/>
        <TextBlock x:Name="ErrorText" FontSize="11" Foreground="{DynamicResource KrosteDangerBrush}" TextWrapping="Wrap" IsVisible="False"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
          <Button Content="{l:Tr Common_Cancel}" Click="OnCancel" Padding="14,6"/>
          <Button Content="{l:Tr Common_Ok}" Click="OnOk" Padding="18,6" Background="{DynamicResource KrosteSuccessBrush}" Foreground="White"/>
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</views:ChromeWindow>
