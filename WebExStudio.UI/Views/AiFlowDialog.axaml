<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:WebExStudio.UI.Controls"
        xmlns:views="using:WebExStudio.UI.Views"
        xmlns:l="using:WebExStudio.UI.Localization"
        x:Class="WebExStudio.UI.Views.AiFlowDialog"
        Title="WebExStudio"
        Width="560" Height="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource KrosteBackgroundBrush}">

  <Border BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="1">
    <DockPanel>
      <controls:TitleBar DockPanel.Dock="Top" Title="{l:Tr Af_Title}" Icon="🤖" />

      <Border DockPanel.Dock="Bottom" Background="{DynamicResource KrosteTitleBarBrush}"
              BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
          <TextBlock x:Name="StatusText" Grid.Column="0" Text=""
                     Foreground="{DynamicResource KrosteMutedTextBrush}" FontSize="12" VerticalAlignment="Center"/>
          <Button x:Name="LoadAnywayButton" Grid.Column="1" Content="{l:Tr Af_LoadAnyway}"
                  Click="OnLoadAnyway" Padding="12,6" Margin="0,0,8,0" IsVisible="False"/>
          <Button Grid.Column="2" Content="{l:Tr Common_Close}" Click="OnCancel" Padding="14,6" Margin="0,0,8,0"/>
          <Button x:Name="GenerateButton" Grid.Column="3" Content="{l:Tr Af_Generate}"
                  Click="OnGenerate" Padding="14,6"
                  Background="{DynamicResource KrosteSuccessBrush}" Foreground="White"/>
        </Grid>
      </Border>

      <Grid Margin="20" RowDefinitions="Auto,Auto,*">
        <TextBlock Grid.Row="0"
                   Text="{l:Tr Af_Intro}"
                   FontSize="12" Foreground="{DynamicResource KrosteSecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <TextBox Grid.Row="1" x:Name="PromptBox"
                 Height="150" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 PlaceholderText="{l:Tr Af_PromptPlaceholder}"/>

        <Border Grid.Row="2" Margin="0,12,0,0" Background="{DynamicResource WxSunkenBrush}"
                BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="1" CornerRadius="4"
                IsVisible="False" x:Name="ResultPanel">
          <ScrollViewer>
            <TextBlock x:Name="ResultText" Margin="10" FontSize="12"
                       FontFamily="Cascadia Mono,Consolas,monospace"
                       Foreground="{DynamicResource KrosteDangerBrush}" TextWrapping="Wrap"/>
          </ScrollViewer>
        </Border>
      </Grid>
    </DockPanel>
  </Border>
</views:ChromeWindow>
