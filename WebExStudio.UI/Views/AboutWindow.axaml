<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WebExStudio.UI.Views.AboutWindow"
        Title="Über WebExStudio"
        Width="420" Height="370"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        WindowDecorations="None"
        Background="#12121F">

  <Border BorderBrush="#2E2E4E" BorderThickness="1">
    <Grid RowDefinitions="Auto,*">

      <!-- Titelleiste -->
      <Border Grid.Row="0" Background="#1E1E2E"
              BorderBrush="#2E2E4E" BorderThickness="0,0,0,1"
              PointerPressed="OnTitleBarPointerPressed">
        <Grid ColumnDefinitions="*,Auto" Height="36">
          <TextBlock Grid.Column="0"
                     Text="Über WebExStudio" FontSize="12" FontWeight="SemiBold"
                     Foreground="#90A4AE"
                     VerticalAlignment="Center" Margin="14,0"
                     IsHitTestVisible="False" />
          <Button Grid.Column="1" Click="OnTitleClose"
                  Content="&#x2715;" FontSize="13"
                  Background="Transparent" Foreground="#90A4AE"
                  BorderThickness="0" Width="40" Height="36" Padding="0" />
        </Grid>
      </Border>

      <!-- Inhalt -->
      <StackPanel Grid.Row="1" Margin="28,22,28,20" Spacing="0">

        <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
          <TextBlock Text="🌐" FontSize="44" VerticalAlignment="Center" />
          <StackPanel VerticalAlignment="Center" Spacing="4">
            <TextBlock Text="WebExStudio" FontSize="20" FontWeight="Bold"
                       Foreground="White" />
            <TextBlock x:Name="VersionText" FontSize="12"
                       Foreground="#90A4AE" />
          </StackPanel>
        </StackPanel>

        <Border Height="1" Background="#2E2E4E" Margin="0,18" />

        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto"
              HorizontalAlignment="Center" ColumnSpacing="16" RowSpacing="6">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Organisation"
                     FontSize="12" Foreground="#607D8B" />
          <TextBlock Grid.Row="0" Grid.Column="1" Text="Landeshauptstadt Potsdam"
                     FontSize="12" Foreground="#B0BEC5" />
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Fachbereich"
                     FontSize="12" Foreground="#607D8B" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="54.2"
                     FontSize="12" Foreground="#B0BEC5" />
          <TextBlock Grid.Row="2" Grid.Column="0" Text="Entwickler"
                     FontSize="12" Foreground="#607D8B" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="Lars Oste"
                     FontSize="12" Foreground="#B0BEC5" />
        </Grid>

        <Border Height="1" Background="#2E2E4E" Margin="0,18" />

        <Button Click="OnHelp" HorizontalAlignment="Center"
                Content="📖  Hilfe / Kurzanleitung"
                Background="#1E2A38" Foreground="#4FC3F7" BorderThickness="0"
                Padding="14,7" FontSize="12" Cursor="Hand"
                ToolTip.Tip="Kurzanleitung zur Bedienung öffnen" />

        <TextBlock HorizontalAlignment="Center" Margin="0,14,0,0"
                   FontSize="11" Foreground="#546E7A"
                   Text="© 2026 Landeshauptstadt Potsdam" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
