<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:WebExStudio.UI.Controls"
        xmlns:views="using:WebExStudio.UI.Views"
        xmlns:l="using:WebExStudio.UI.Localization"
        x:Class="WebExStudio.UI.Views.NodeSearchDialog"
        Title="WebExStudio"
        Width="460" Height="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource KrosteBackgroundBrush}">

  <Border BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="1">
    <DockPanel>
      <controls:TitleBar DockPanel.Dock="Top" Title="{l:Tr Search_Title}" Icon="🔍" />

      <TextBox DockPanel.Dock="Top" x:Name="SearchBox" Margin="10" Padding="8,6"
               PlaceholderText="{l:Tr Search_Placeholder}"
               TextChanged="OnFilter" KeyDown="OnSearchKeyDown"/>

      <ListBox x:Name="ResultList" Background="Transparent" Margin="6,0,6,8"
               DoubleTapped="OnAccept">
        <ListBox.ItemTemplate>
          <DataTemplate x:CompileBindings="False">
            <StackPanel Spacing="0" Margin="4,2">
              <TextBlock Text="{Binding Display}" Foreground="White" FontSize="12"/>
              <TextBlock Text="{Binding Sub}" Foreground="{DynamicResource KrosteMutedTextBrush}" FontSize="10"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Border>
</views:ChromeWindow>
