<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:WebExStudio.UI.Controls"
        xmlns:views="using:WebExStudio.UI.Views"
        xmlns:l="using:WebExStudio.UI.Localization"
        x:Class="WebExStudio.UI.Views.CredentialVaultWindow"
        Title="WebExStudio"
        Width="560" Height="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource KrosteBackgroundBrush}">

  <Border BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="1">
    <DockPanel>
      <controls:TitleBar DockPanel.Dock="Top" Title="{l:Tr Vault_Title}" Icon="🔒" />

      <!-- Entsperr-Bereich -->
      <StackPanel x:Name="UnlockPanel" DockPanel.Dock="Top" Margin="18,14" Spacing="8">
        <TextBlock x:Name="UnlockHint" FontSize="12" Foreground="{DynamicResource KrosteSecondaryTextBrush}" TextWrapping="Wrap"/>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox Grid.Column="0" x:Name="UnlockPwBox" PasswordChar="•" PlaceholderText="{l:Tr Pw_MasterPlaceholder}"
                   KeyDown="OnUnlockKeyDown"/>
          <Button Grid.Column="1" x:Name="UnlockButton" Click="OnUnlock" Padding="14,6"
                  Background="{DynamicResource KrosteSuccessBrush}" Foreground="White"/>
        </Grid>
        <TextBlock x:Name="UnlockError" FontSize="11" Foreground="{DynamicResource KrosteDangerBrush}" IsVisible="False" TextWrapping="Wrap"/>
      </StackPanel>

      <!-- Verwaltung (nach Entsperren) -->
      <Grid x:Name="ManagePanel" IsVisible="False" Margin="14" RowDefinitions="*,Auto" ColumnDefinitions="200,*">
        <!-- Einträge -->
        <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
          <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" Margin="0,6,0,0">
            <TextBox Grid.Column="0" x:Name="NewNameBox" PlaceholderText="{l:Tr Vault_NewNamePlaceholder}"/>
            <Button Grid.Column="1" Content="＋" Click="OnAddEntry" Padding="8,2" ToolTip.Tip="{l:Tr Vault_AddTip}"/>
            <Button Grid.Column="2" Content="🗑" Click="OnDeleteEntry" Padding="8,2" ToolTip.Tip="{l:Tr Vault_DeleteTip}"/>
          </Grid>
          <ListBox x:Name="NamesList" Background="{DynamicResource KrosteTitleBarBrush}" SelectionChanged="OnSelectEntry"/>
        </DockPanel>

        <!-- Felder des Eintrags -->
        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
          <TextBlock x:Name="EntryTitle" Text="{l:Tr Vault_NoEntry}" Foreground="White" FontWeight="SemiBold"/>
          <TextBlock Text="{l:Tr Vault_FieldUser}" FontSize="11" Foreground="{DynamicResource KrosteMutedTextBrush}"/>
          <TextBox x:Name="UserBox"/>
          <TextBlock Text="{l:Tr Vault_FieldPassword}" FontSize="11" Foreground="{DynamicResource KrosteMutedTextBrush}"/>
          <TextBox x:Name="PassBox" PasswordChar="•"/>
          <TextBlock Text="{l:Tr Vault_FieldApi}" FontSize="11" Foreground="{DynamicResource KrosteMutedTextBrush}"/>
          <TextBox x:Name="ApiBox" PasswordChar="•"/>
          <Button x:Name="SaveEntryButton" Content="{l:Tr Vault_SaveEntry}" Click="OnSaveEntry"
                  HorizontalAlignment="Left" Padding="12,5" Margin="0,4,0,0"/>
          <TextBlock x:Name="ManageStatus" FontSize="11" Foreground="{DynamicResource KrosteSuccessBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Fußzeile -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
          <Button Content="{l:Tr Vault_ChangePassword}" Click="OnChangePassword" Padding="10,5"/>
          <Button Content="{l:Tr Vault_Lock}" Click="OnLock" Padding="10,5"/>
          <Button Content="{l:Tr Common_Close}" Click="OnClose" Padding="14,5" HorizontalAlignment="Right"/>
        </StackPanel>
      </Grid>
    </DockPanel>
  </Border>
</views:ChromeWindow>
