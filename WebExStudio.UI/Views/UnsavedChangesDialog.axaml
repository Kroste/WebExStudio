<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:WebExStudio.UI.Controls"
        xmlns:views="using:WebExStudio.UI.Views"
        xmlns:l="using:WebExStudio.UI.Localization"
        x:Class="WebExStudio.UI.Views.UnsavedChangesDialog"
        Title="WebExStudio"
        Width="440" SizeToContent="Height"
        MinWidth="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource KrosteBackgroundBrush}">

  <Border BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="1">
    <Grid RowDefinitions="Auto,*">
      <controls:TitleBar x:Name="WindowTitleBar" Grid.Row="0" Icon="💾" Title="{l:Tr Unsaved_Title}" />

      <StackPanel Grid.Row="1" Margin="18" Spacing="10">
        <TextBlock x:Name="MessageText" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource KrosteSecondaryTextBrush}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
          <Button Content="{l:Tr Common_Cancel}" Click="OnCancel" Padding="14,6"/>
          <Button Content="{l:Tr Unsaved_Discard}" Click="OnDiscard" Padding="14,6"
                  Background="{DynamicResource KrosteDangerBrush}" Foreground="White"/>
          <Button Content="{l:Tr Unsaved_Save}" Click="OnSave" Padding="18,6"
                  Background="{DynamicResource KrosteSuccessBrush}" Foreground="White"/>
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</views:ChromeWindow>
