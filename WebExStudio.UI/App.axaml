<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WebExStudio.UI.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <!-- ================================================================ -->
        <!-- Kroste-Palette — die einzige Quelle für Farben.                   -->
        <!-- Im XAML stehen NUR DynamicResource-Keys, keine #RRGGBB-Literale:  -->
        <!-- ein Literal irgendwo im Baum lässt sich später nicht mehr zentral -->
        <!-- ändern und driftet garantiert. Abgesichert durch                  -->
        <!-- WebExStudio.UI.Tests/ResourceKeyTests.                            -->
        <!-- ================================================================ -->
        <SolidColorBrush x:Key="KrosteBackgroundBrush" Color="#1A1D21" />
        <SolidColorBrush x:Key="KrosteTitleBarBrush" Color="#14161A" />
        <SolidColorBrush x:Key="KrosteSurfaceBrush" Color="#22262B" />
        <SolidColorBrush x:Key="KrosteCardBrush" Color="#1F2328" />
        <SolidColorBrush x:Key="KrosteAccentBrush" Color="#123E6B" />
        <SolidColorBrush x:Key="KrosteAccentHoverBrush" Color="#1B5390" />
        <SolidColorBrush x:Key="KrosteAccentSoftBrush" Color="#1E3A5C" />
        <SolidColorBrush x:Key="KrosteGoldBrush" Color="#E0B14C" />
        <SolidColorBrush x:Key="KrosteBorderBrush" Color="#2E343C" />
        <SolidColorBrush x:Key="KrosteBorderStrongBrush" Color="#3C444E" />
        <SolidColorBrush x:Key="KrosteMutedTextBrush" Color="#8A93A0" />
        <SolidColorBrush x:Key="KrosteSecondaryTextBrush" Color="#B7BEC7" />
        <SolidColorBrush x:Key="KrosteTextBrush" Color="#E4E7EC" />
        <SolidColorBrush x:Key="KrosteDangerBrush" Color="#C42B1C" />
        <SolidColorBrush x:Key="KrosteSuccessBrush" Color="#3AA55B" />

        <!-- ================================================================ -->
        <!-- Projekteigene Rollen — alles, wofür die Standardpalette keine     -->
        <!-- Entsprechung hat. Bewusst hier und nicht im Fenster-XAML.         -->
        <!-- ================================================================ -->
        <!-- Versenkte Flächen (Ergebnis-/Ausgabepanels): eine Stufe dunkler als
             der Fensterhintergrund, damit sie als "hineingelegt" lesbar sind. -->
        <SolidColorBrush x:Key="WxSunkenBrush" Color="#141619" />
        <!-- Text, der noch schwächer als "muted" sein soll (Platzhalter, Fußnoten). -->
        <SolidColorBrush x:Key="WxFaintTextBrush" Color="#6D7681" />
        <!-- Subflow-Markierung im Editor (goldene Lasur über der Karte). -->
        <SolidColorBrush x:Key="WxSubflowFillBrush" Color="#28E0B14C" />
        <SolidColorBrush x:Key="WxSubflowBorderBrush" Color="#50E0B14C" />
        <!-- "Buy me a coffee" behält bewusst seine Markenfarbe — deshalb hier als
             benannte Rolle statt als Literal im About-Fenster. -->
        <SolidColorBrush x:Key="BuyMeACoffeeBrush" Color="#FFDD00" />
        <SolidColorBrush x:Key="BuyMeACoffeeTextBrush" Color="#1A1400" />
        <!-- Schrift auf gefüllten Akzent-/Statusflächen. -->
        <SolidColorBrush x:Key="KrosteOnAccentTextBrush" Color="#F5F7FA" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- ================================================================ -->
        <!-- Fenster-Grundlage                                                 -->
        <!-- ================================================================ -->
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource KrosteBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource KrosteTextBrush}" />
        </Style>

        <!-- ================================================================ -->
        <!-- Titelleiste (Kroste-Chrome-Standard)                              -->
        <!-- ================================================================ -->
        <Style Selector="Button.chrome">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource KrosteMutedTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.chrome /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.chrome:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource KrosteSurfaceBrush}" />
        </Style>
        <Style Selector="Button.chrome.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource KrosteDangerBrush}" />
        </Style>
        <Style Selector="Button.chrome.close:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource KrosteOnAccentTextBrush}" />
        </Style>

        <!-- ================================================================ -->
        <!-- Buttons — konsistenter Basis-Look, Varianten via Klasse           -->
        <!-- ================================================================ -->
        <Style Selector="Button">
            <Setter Property="Background" Value="{DynamicResource KrosteSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource KrosteTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource KrosteBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource KrosteSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource KrosteBorderStrongBrush}" />
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource WxSunkenBrush}" />
        </Style>
        <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <!-- Primäre Aktion. WICHTIG: FluentTheme hat eine EINGEBAUTE accent-Klasse,
             die den ContentPresenter einfärbt und einen Setter auf Button.Background
             überstimmt — der Akzent muss deshalb direkt am ContentPresenter sitzen. -->
        <Style Selector="Button.accent">
            <Setter Property="Foreground" Value="{DynamicResource KrosteOnAccentTextBrush}" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource KrosteAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource KrosteAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource KrosteOnAccentTextBrush}" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource KrosteAccentHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource KrosteAccentHoverBrush}" />
        </Style>

        <!-- Ghost: rein textlich, Hover bekommt subtiles Background. -->
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource KrosteSecondaryTextBrush}" />
        </Style>
        <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource KrosteSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <!-- Gefährliche Aktion (löschen/verwerfen): roter Hover-State. -->
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource KrosteDangerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource KrosteDangerBrush}" />
        </Style>

        <!-- ================================================================ -->
        <!-- Cards / Sektionen                                                 -->
        <!-- ================================================================ -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource KrosteCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource KrosteBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style Selector="Border.card-flat">
            <Setter Property="Background" Value="{DynamicResource KrosteCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource KrosteBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!-- ================================================================ -->
        <!-- Text-Rollen                                                       -->
        <!-- ================================================================ -->
        <Style Selector="TextBlock.h1">
            <Setter Property="Foreground" Value="{DynamicResource KrosteGoldBrush}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="Foreground" Value="{DynamicResource KrosteGoldBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.section-label">
            <Setter Property="Foreground" Value="{DynamicResource KrosteMutedTextBrush}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource KrosteMutedTextBrush}" />
        </Style>
        <Style Selector="TextBlock.secondary">
            <Setter Property="Foreground" Value="{DynamicResource KrosteSecondaryTextBrush}" />
        </Style>

        <!-- ================================================================ -->
        <!-- Formularfelder — dunkler, Fokus-Ring in Gold                      -->
        <!-- ================================================================ -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource KrosteSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource KrosteTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource KrosteBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource KrosteBorderStrongBrush}" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource KrosteGoldBrush}" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource KrosteSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource KrosteTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource KrosteBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
        <Style Selector="ComboBox:focus /template/ Border#Background">
            <Setter Property="BorderBrush" Value="{DynamicResource KrosteGoldBrush}" />
        </Style>

        <!-- ================================================================ -->
        <!-- ProgressBar — dünn, Gold                                          -->
        <!-- ================================================================ -->
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource KrosteGoldBrush}" />
            <Setter Property="Background" Value="{DynamicResource KrosteSurfaceBrush}" />
            <Setter Property="MinHeight" Value="6" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>

        <!-- ================================================================ -->
        <!-- Divider                                                           -->
        <!-- ================================================================ -->
        <Style Selector="Rectangle.divider-v">
            <Setter Property="Width" Value="1" />
            <Setter Property="Fill" Value="{DynamicResource KrosteBorderBrush}" />
            <Setter Property="Margin" Value="6,4" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Rectangle.divider-h">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="{DynamicResource KrosteBorderBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </Application.Styles>
</Application>
