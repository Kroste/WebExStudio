<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Ausführbare Datei heißt "WebExStudio" (nicht "WebExStudio.UI") — schöner im Paket/AppImage. -->
    <AssemblyName>WebExStudio</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
    <PackageReference Include="ReactiveUI.Avalonia" Version="12.0.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NLog" Version="6.1.3" />
    <PackageReference Include="NLog.Extensions.Logging" Version="6.1.3" />
    <PackageReference Include="ReactiveUI" Version="23.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="NLog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- README wird eingebettet und im Hilfefenster gerendert → Hilfe = immer aktuelle README.
         Sprachvarianten README.<code>.md (z. B. README.en.md) werden je nach UI-Sprache gewählt;
         Fallback ist die deutsche README.md. -->
    <EmbeddedResource Include="..\README.md" Link="README.md" LogicalName="WebExStudio.UI.README.md" />
    <!-- WithCulture=false: sonst deutet MSBuild das ".en." im Dateinamen als Kultur "en" und packt die
         Datei in eine Satelliten-Assembly (en/…) statt ins Haupt-Assembly. -->
    <EmbeddedResource Include="..\README.en.md" Link="README.en.md" LogicalName="WebExStudio.UI.README.en.md" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebExStudio.Core\WebExStudio.Core.csproj" />
    <ProjectReference Include="..\WebExStudio.Engine\WebExStudio.Engine.csproj" />
    <ProjectReference Include="..\WebExStudio.AI\WebExStudio.AI.csproj" />
  </ItemGroup>
</Project>
