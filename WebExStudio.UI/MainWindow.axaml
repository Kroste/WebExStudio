<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WebExStudio.UI.ViewModels"
        xmlns:views="using:WebExStudio.UI.Views"
        x:Class="WebExStudio.UI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="WebExStudio"
        Width="1400" Height="900"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Background="#12121F">

  <DockPanel>

    <!-- ── Custom title bar ── -->
    <Border DockPanel.Dock="Top"
            Background="#16162A" BorderBrush="#2E2E4E"
            BorderThickness="0,0,0,1"
            PointerPressed="OnTitleBarPointerPressed"
            DoubleTapped="OnTitleBarDoubleTapped">
      <Grid ColumnDefinitions="Auto,*,Auto" Height="34">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center" Margin="12,0">
          <TextBlock Text="🌐" FontSize="14" VerticalAlignment="Center"/>
          <TextBlock Text="WebExStudio" FontSize="12" FontWeight="SemiBold"
                     Foreground="#90A4AE" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
          <Button Content="⚙" Click="OnSettings" ToolTip.Tip="Einstellungen"
                  Background="Transparent" Foreground="#90A4AE" BorderThickness="0"
                  Width="42" Padding="0" FontSize="14"/>
          <Button Content="❓" Click="OnHelp" ToolTip.Tip="Hilfe / Kurzanleitung"
                  Background="Transparent" Foreground="#90A4AE" BorderThickness="0"
                  Width="42" Padding="0" FontSize="14"/>
          <Button Content="ℹ" Click="OnAbout" ToolTip.Tip="Über"
                  Background="Transparent" Foreground="#90A4AE" BorderThickness="0"
                  Width="42" Padding="0" FontSize="14"/>
          <Button Content="&#x2014;" Click="OnMinimize" ToolTip.Tip="Minimieren"
                  Background="Transparent" Foreground="#90A4AE" BorderThickness="0"
                  Width="42" Padding="0" FontSize="13"/>
          <Button Content="&#x2610;" Click="OnToggleMaximize" ToolTip.Tip="Maximieren"
                  Background="Transparent" Foreground="#90A4AE" BorderThickness="0"
                  Width="42" Padding="0" FontSize="13"/>
          <Button Content="&#x2715;" Click="OnCloseWindow" ToolTip.Tip="Schließen"
                  Background="Transparent" Foreground="#90A4AE" BorderThickness="0"
                  Width="46" Padding="0" FontSize="13"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ── Toolbar ── -->
    <Border DockPanel.Dock="Top"
            Background="#1E1E2E" BorderBrush="#2E2E4E"
            BorderThickness="0,0,0,1" Padding="8,4">
      <StackPanel Orientation="Horizontal" Spacing="6">

        <Button Content="✨ Neuer Flow"     Click="OnNewFlow"     Padding="8,4"/>
        <Button Content="📄 Flow öffnen"    Click="OnOpenFlow"    Padding="8,4"/>
        <Button Content="🕘" Click="OnRecent" Padding="8,4" ToolTip.Tip="Zuletzt geöffnete Flows"/>
        <Button Content="💾 Speichern"      Click="OnSaveFlow"    Padding="8,4"
                IsEnabled="{Binding FlowEditor.CanSave}"/>
        <Button Content="♻ Convert"         Click="OnConvert"     Padding="8,4"
                ToolTip.Tip="Alten (Python-)Flow aus einem Projektordner in das neue Format konvertieren"/>
        <Button Content="↶" Click="OnUndo" Padding="8,4" ToolTip.Tip="Rückgängig (Strg+Z)"
                IsEnabled="{Binding FlowEditor.CanUndo}"/>
        <Button Content="↷" Click="OnRedo" Padding="8,4" ToolTip.Tip="Wiederholen (Strg+Y)"
                IsEnabled="{Binding FlowEditor.CanRedo}"/>
        <Button Content="🤖 KI-Flow"        Click="OnGenerateFlow" Padding="8,4"
                ToolTip.Tip="Flow aus einer Beschreibung erzeugen"/>
        <Button Content="💬 KI-Chat"        Click="OnChat" Padding="8,4"
                ToolTip.Tip="Chat-Fenster mit der KI öffnen"/>
        <Button Content="🧾 Erklären"       Click="OnExplainFlow" Padding="8,4"
                ToolTip.Tip="Den aktuellen Flow von der KI erklären lassen"/>
        <Button Content="💡 Vorschlag"      Click="OnSuggestNode" Padding="8,4"
                IsEnabled="{Binding SuggestionsEnabled}"
                ToolTip.Tip="Nächsten Node nach dem ausgewählten von der KI vorschlagen lassen"/>
        <Button Content="🔐 Tresor"         Click="OnVault" Padding="8,4"
                ToolTip.Tip="Anmeldedaten-Tresor verwalten (verschlüsselt, {secret[name].feld})"/>

        <Separator Width="1" Background="#2E2E4E" Margin="4,0"/>

        <Button Content="▶ Ausführen" Click="OnRun" Padding="8,4"
                IsEnabled="{Binding CanRun}"
                Background="#1B5E20" Foreground="White"/>
        <Button Content="⏹ Stopp"    Click="OnStop" Padding="8,4"
                IsEnabled="{Binding CanStop}"
                Background="#B71C1C" Foreground="White"/>
        <Button Content="⏸ Pause"    Click="OnPause" Padding="8,4"
                IsVisible="{Binding CanPause}"
                Background="#F57F17" Foreground="White"/>
        <Button Content="👣 Schritt"  Click="OnStep" Padding="8,4"
                IsVisible="{Binding CanStep}"
                ToolTip.Tip="Einen Node weiter, dann wieder pausieren"
                Background="#1565C0" Foreground="White"/>
        <Button Content="⏭ Weiter"   Click="OnResume" Padding="8,4"
                IsVisible="{Binding IsPaused}"
                Background="#2E7D32" Foreground="White"/>

        <Separator Width="1" Background="#2E2E4E" Margin="4,0"/>

        <Button Content="🔎 Suchen"     Click="OnSearchNode" Padding="8,4"
                ToolTip.Tip="Node suchen / dorthin springen (Strg+F)"/>
        <Button Content="🪄 Layout"     Click="OnAutoLayout" Padding="8,4"
                ToolTip.Tip="Nodes automatisch anordnen"/>
        <Button Content="▦ Ausrichten"  Click="OnSnapToGrid" Padding="8,4"
                ToolTip.Tip="Alle Nodes am Raster ausrichten"/>
        <Button Content="⊞ Fit"         Click="OnFitView"   Padding="8,4"/>
        <Button Content="🔍 Reset View" Click="OnResetView" Padding="8,4"/>
      </StackPanel>
    </Border>

    <!-- ── Statusleiste (unten) ── -->
    <Border DockPanel.Dock="Bottom"
            Background="#16162A" BorderBrush="#2E2E4E"
            BorderThickness="0,1,0,0" Padding="10,3">
      <Grid ColumnDefinitions="*,Auto">
        <!-- Links: aktueller Status / Operation -->
        <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                   VerticalAlignment="Center" Foreground="#B0BEC5" FontSize="12"
                   TextTrimming="CharacterEllipsis"/>

        <!-- Rechts: Flow-Infos, KI-Status, Vorschlag-Schalter -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0"
                    VerticalAlignment="Center">
          <TextBlock Text="{Binding FlowEditor.Title}" Foreground="#90A4AE" FontSize="12"
                     VerticalAlignment="Center"/>
          <Border Width="1" Background="#2E2E4E" Margin="10,2"/>
          <TextBlock Text="{Binding FlowEditor.ActiveTab.Label, StringFormat='Tab: {0}'}"
                     Foreground="#90A4AE" FontSize="12" VerticalAlignment="Center"/>
          <Border Width="1" Background="#2E2E4E" Margin="10,2"/>
          <TextBlock Text="{Binding FlowEditor.Nodes.Count, StringFormat='Nodes: {0}'}"
                     Foreground="#90A4AE" FontSize="12" VerticalAlignment="Center"/>
          <Border Width="1" Background="#2E2E4E" Margin="10,2"/>
          <TextBlock Text="{Binding AiStatus}" Foreground="#90A4AE" FontSize="12"
                     VerticalAlignment="Center"/>
          <Border Width="1" Background="#2E2E4E" Margin="10,2"/>
          <CheckBox IsChecked="{Binding SuggestionsEnabled}"
                    Content="Node-Vorschlag" Foreground="#B0BEC5" FontSize="12"
                    VerticalAlignment="Center"
                    ToolTip.Tip="KI-Vorschlag für den nächsten Node ein-/ausschalten"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ── Main Area ── -->
    <Grid ColumnDefinitions="220,*,320">

      <!-- Left: Node Palette (top) + Subnodes (bottom) -->
      <Border Grid.Column="0"
              Background="#1A1A2E" BorderBrush="#2E2E4E"
              BorderThickness="0,0,1,0">
        <Grid RowDefinitions="*,6,220">
          <views:NodePaletteView Grid.Row="0" DataContext="{Binding}"/>
          <GridSplitter Grid.Row="1" Background="#2E2E4E" ResizeDirection="Rows" Margin="0"/>
          <views:SubnodePanelView Grid.Row="2" DataContext="{Binding}"/>
        </Grid>
      </Border>

      <!-- Center: Flow Editor + Trace panel -->
      <Grid Grid.Column="1" RowDefinitions="*,6,200">

        <Border Grid.Row="0" Background="#12121F">
          <views:FlowEditorView x:Name="FlowEditorView"
                                DataContext="{Binding FlowEditor}"/>
        </Border>

        <GridSplitter Grid.Row="1" Background="#2E2E4E"
                      ResizeDirection="Rows" Margin="0"/>

        <Border Grid.Row="2"
                Background="#1A1A2E" BorderBrush="#2E2E4E"
                BorderThickness="0,1,0,0">
          <views:TracePanelView DataContext="{Binding TracePanel}"/>
        </Border>
      </Grid>

      <!-- Right: Properties (with description + example) -->
      <Border Grid.Column="2"
              Background="#1A1A2E" BorderBrush="#2E2E4E"
              BorderThickness="1,0,0,0">
        <views:PropertiesPanelView DataContext="{Binding FlowEditor}"/>
      </Border>

    </Grid>
  </DockPanel>
</Window>
