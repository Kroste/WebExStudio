<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WebExStudio.UI.ViewModels"
        xmlns:views="using:WebExStudio.UI.Views"
        xmlns:l="using:WebExStudio.UI.Localization"
        x:Class="WebExStudio.UI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="WebExStudio"
        Width="1400" Height="900"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Background="#12121F">

  <DockPanel>

    <!-- ── Custom title bar ── -->
    <Border DockPanel.Dock="Top"
            Background="#16162A" BorderBrush="#2E2E4E"
            BorderThickness="0,0,0,1"
            PointerPressed="OnTitleBarPointerPressed"
            DoubleTapped="OnTitleBarDoubleTapped">
      <Grid ColumnDefinitions="Auto,*,Auto" Height="34">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center" Margin="12,0">
          <TextBlock Text="🌐" FontSize="14" VerticalAlignment="Center"/>
          <TextBlock Text="WebExStudio" FontSize="12" FontWeight="SemiBold"
                     Foreground="#90A4AE" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
          <Button Content="⚙" Click="OnSettings" ToolTip.Tip="{l:Tr Tip_Settings}"
                  Background="Transparent" Foreground="#90A4AE" BorderThickness="0"
                  Width="42" Padding="0" FontSize="14"/>
          <Button Content="❓" Click="OnHelp" ToolTip.Tip="{l:Tr Tip_Help}"
                  Background="Transparent" Foreground="#90A4AE" BorderThickness="0"
                  Width="42" Padding="0" FontSize="14"/>
          <Button Content="ℹ" Click="OnAbout" ToolTip.Tip="{l:Tr Tip_About}"
                  Background="Transparent" Foreground="#90A4AE" BorderThickness="0"
                  Width="42" Padding="0" FontSize="14"/>
          <Button Content="&#x2014;" Click="OnMinimize" ToolTip.Tip="{l:Tr Tip_Minimize}"
                  Background="Transparent" Foreground="#90A4AE" BorderThickness="0"
                  Width="42" Padding="0" FontSize="13"/>
          <Button Content="&#x2610;" Click="OnToggleMaximize" ToolTip.Tip="{l:Tr Tip_Maximize}"
                  Background="Transparent" Foreground="#90A4AE" BorderThickness="0"
                  Width="42" Padding="0" FontSize="13"/>
          <Button Content="&#x2715;" Click="OnCloseWindow" ToolTip.Tip="{l:Tr Tip_Close}"
                  Background="Transparent" Foreground="#90A4AE" BorderThickness="0"
                  Width="46" Padding="0" FontSize="13"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ── Toolbar ── -->
    <Border DockPanel.Dock="Top"
            Background="#1E1E2E" BorderBrush="#2E2E4E"
            BorderThickness="0,0,0,1" Padding="8,4">
      <StackPanel Orientation="Horizontal" Spacing="6">

        <Button Content="{l:Tr Tb_NewFlow}"  Click="OnNewFlow"     Padding="8,4"/>
        <Button Content="{l:Tr Tb_OpenFlow}" Click="OnOpenFlow"    Padding="8,4"/>
        <Button Content="🕘" Click="OnRecent" Padding="8,4" ToolTip.Tip="{l:Tr Tip_Recent}"/>
        <Button Content="{l:Tr Tb_Save}"     Click="OnSaveFlow"    Padding="8,4"
                IsEnabled="{Binding FlowEditor.CanSave}"/>
        <Button Content="{l:Tr Tb_Convert}"  Click="OnConvert"     Padding="8,4"
                ToolTip.Tip="{l:Tr Tip_Convert}"/>
        <Button Content="↶" Click="OnUndo" Padding="8,4" ToolTip.Tip="{l:Tr Tip_Undo}"
                IsEnabled="{Binding FlowEditor.CanUndo}"/>
        <Button Content="↷" Click="OnRedo" Padding="8,4" ToolTip.Tip="{l:Tr Tip_Redo}"
                IsEnabled="{Binding FlowEditor.CanRedo}"/>
        <Button Content="{l:Tr Tb_AiFlow}"   Click="OnGenerateFlow" Padding="8,4"
                ToolTip.Tip="{l:Tr Tip_AiFlow}"/>
        <Button Content="{l:Tr Tb_AiChat}"   Click="OnChat" Padding="8,4"
                ToolTip.Tip="{l:Tr Tip_AiChat}"/>
        <Button Content="{l:Tr Tb_Explain}"  Click="OnExplainFlow" Padding="8,4"
                ToolTip.Tip="{l:Tr Tip_Explain}"/>
        <Button Content="{l:Tr Tb_Suggest}"  Click="OnSuggestNode" Padding="8,4"
                IsEnabled="{Binding SuggestionsEnabled}"
                ToolTip.Tip="{l:Tr Tip_Suggest}"/>
        <Button Content="{l:Tr Tb_Vault}"    Click="OnVault" Padding="8,4"
                ToolTip.Tip="{l:Tr Tip_Vault}"/>

        <Separator Width="1" Background="#2E2E4E" Margin="4,0"/>

        <Button Content="{l:Tr Tb_Run}" Click="OnRun" Padding="8,4"
                IsEnabled="{Binding CanRun}"
                Background="#1B5E20" Foreground="White"/>
        <Button Content="{l:Tr Tb_Stop}"    Click="OnStop" Padding="8,4"
                IsEnabled="{Binding CanStop}"
                Background="#B71C1C" Foreground="White"/>
        <Button Content="{l:Tr Tb_Pause}"    Click="OnPause" Padding="8,4"
                IsVisible="{Binding CanPause}"
                Background="#F57F17" Foreground="White"/>
        <Button Content="{l:Tr Tb_Step}"  Click="OnStep" Padding="8,4"
                IsVisible="{Binding CanStep}"
                ToolTip.Tip="{l:Tr Tip_Step}"
                Background="#1565C0" Foreground="White"/>
        <Button Content="{l:Tr Tb_Resume}"   Click="OnResume" Padding="8,4"
                IsVisible="{Binding IsPaused}"
                Background="#2E7D32" Foreground="White"/>

        <Separator Width="1" Background="#2E2E4E" Margin="4,0"/>

        <Button Content="{l:Tr Tb_Search}"     Click="OnSearchNode" Padding="8,4"
                ToolTip.Tip="{l:Tr Tip_Search}"/>
        <Button Content="{l:Tr Tb_Layout}"     Click="OnAutoLayout" Padding="8,4"
                ToolTip.Tip="{l:Tr Tip_Layout}"/>
        <Button Content="{l:Tr Tb_Align}"  Click="OnSnapToGrid" Padding="8,4"
                ToolTip.Tip="{l:Tr Tip_Align}"/>
        <Button Content="{l:Tr Tb_Fit}"         Click="OnFitView"   Padding="8,4"/>
        <Button Content="{l:Tr Tb_Reset}" Click="OnResetView" Padding="8,4"/>
      </StackPanel>
    </Border>

    <!-- ── Statusleiste (unten) ── -->
    <Border DockPanel.Dock="Bottom"
            Background="#16162A" BorderBrush="#2E2E4E"
            BorderThickness="0,1,0,0" Padding="10,3">
      <Grid ColumnDefinitions="*,Auto">
        <!-- Links: aktueller Status / Operation -->
        <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                   VerticalAlignment="Center" Foreground="#B0BEC5" FontSize="12"
                   TextTrimming="CharacterEllipsis"/>

        <!-- Rechts: Flow-Infos, KI-Status, Vorschlag-Schalter -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0"
                    VerticalAlignment="Center">
          <TextBlock Text="{Binding FlowEditor.Title}" Foreground="#90A4AE" FontSize="12"
                     VerticalAlignment="Center"/>
          <Border Width="1" Background="#2E2E4E" Margin="10,2"/>
          <TextBlock Text="{Binding FlowEditor.ActiveTab.Label, StringFormat='Tab: {0}'}"
                     Foreground="#90A4AE" FontSize="12" VerticalAlignment="Center"/>
          <Border Width="1" Background="#2E2E4E" Margin="10,2"/>
          <TextBlock Text="{Binding FlowEditor.Nodes.Count, StringFormat='Nodes: {0}'}"
                     Foreground="#90A4AE" FontSize="12" VerticalAlignment="Center"/>
          <Border Width="1" Background="#2E2E4E" Margin="10,2"/>
          <TextBlock Text="{Binding AiStatus}" Foreground="#90A4AE" FontSize="12"
                     VerticalAlignment="Center"/>
          <Border Width="1" Background="#2E2E4E" Margin="10,2"/>
          <CheckBox IsChecked="{Binding SuggestionsEnabled}"
                    Content="{l:Tr Status_NodeSuggest}" Foreground="#B0BEC5" FontSize="12"
                    VerticalAlignment="Center"
                    ToolTip.Tip="{l:Tr Tip_NodeSuggest}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ── Main Area ── -->
    <Grid ColumnDefinitions="220,*,320">

      <!-- Left: Node Palette (top) + Subnodes (bottom) -->
      <Border Grid.Column="0"
              Background="#1A1A2E" BorderBrush="#2E2E4E"
              BorderThickness="0,0,1,0">
        <Grid RowDefinitions="*,6,220">
          <views:NodePaletteView Grid.Row="0" DataContext="{Binding}"/>
          <GridSplitter Grid.Row="1" Background="#2E2E4E" ResizeDirection="Rows" Margin="0"/>
          <views:SubnodePanelView Grid.Row="2" DataContext="{Binding}"/>
        </Grid>
      </Border>

      <!-- Center: Flow Editor + Trace panel -->
      <Grid Grid.Column="1" RowDefinitions="*,6,200">

        <Border Grid.Row="0" Background="#12121F">
          <views:FlowEditorView x:Name="FlowEditorView"
                                DataContext="{Binding FlowEditor}"/>
        </Border>

        <GridSplitter Grid.Row="1" Background="#2E2E4E"
                      ResizeDirection="Rows" Margin="0"/>

        <Border Grid.Row="2"
                Background="#1A1A2E" BorderBrush="#2E2E4E"
                BorderThickness="0,1,0,0">
          <views:TracePanelView DataContext="{Binding TracePanel}"/>
        </Border>
      </Grid>

      <!-- Right: Properties (with description + example) -->
      <Border Grid.Column="2"
              Background="#1A1A2E" BorderBrush="#2E2E4E"
              BorderThickness="1,0,0,0">
        <views:PropertiesPanelView DataContext="{Binding FlowEditor}"/>
      </Border>

    </Grid>
  </DockPanel>
</Window>
